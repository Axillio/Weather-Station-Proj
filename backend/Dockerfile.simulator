FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY demo/python/mqtt_weather_simulator.py ./demo/python/mqtt_weather_simulator.py

CMD ["python", "demo/python/mqtt_weather_simulator.py"]
